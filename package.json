{
  "name": "@neophilism/distributed-audio-engine",
  "version": "0.1.0-dev",
  "private": true,
  "description": "Neutral endpoint-encrypted audio, synchronization and spatial primitives",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./browser": {
      "types": "./dist/src/browser/index.d.ts",
      "import": "./dist/src/browser/index.js",
      "default": "./dist/src/browser/index.js"
    },
    "./node": {
      "types": "./dist/src/node/index.d.ts",
      "import": "./dist/src/node/index.js",
      "default": "./dist/src/node/index.js"
    },
    "./evidence": {
      "types": "./dist/src/evidence.d.ts",
      "import": "./dist/src/evidence.js",
      "default": "./dist/src/evidence.js"
    },
    "./output-lifecycle": {
      "types": "./dist/src/output-lifecycle.d.ts",
      "import": "./dist/src/output-lifecycle.js",
      "default": "./dist/src/output-lifecycle.js"
    },
    "./android": {
      "types": "./dist/src/android/index.d.ts",
      "import": "./dist/src/android/index.js",
      "default": "./dist/src/android/index.js"
    },
    "./ios": {
      "types": "./dist/src/ios/index.d.ts",
      "import": "./dist/src/ios/index.js",
      "default": "./dist/src/ios/index.js"
    }
  },
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/src",
    "src",
    "docs",
    "README.md",
    "AGENTS.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "node scripts/check-source.mjs",
    "roadmap:check": "node scripts/check-roadmap.mjs",
    "portability:check": "tsc --project tests/types/tsconfig.core.json && tsc --project tests/types/tsconfig.browser.json",
    "package:check": "node scripts/check-package.mjs",
    "check": "npm run typecheck && npm run lint && npm run roadmap:check && npm test && npm run portability:check && npm run package:check"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
