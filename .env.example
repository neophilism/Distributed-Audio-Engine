# Routing metadata only. Never put media keys, ratchets or private manifests here.
# Hash independent random 32-byte base64url routing tokens using SHA256(token text).
# The actual bearer tokens stay at their corresponding authorized endpoints.
DAE_RELAY_GRANTS_JSON=[]
# Render supplies RENDER, RENDER_SERVICE_TYPE, RENDER_GIT_REPO_SLUG,
# RENDER_EXTERNAL_URL, RENDER_GIT_COMMIT and PORT. Do not fake these on a public host.
DAE_RELAY_MODE=render-staging
NODE_VERSION=24.19.0
